---
import { LinkButton } from '@astrojs/starlight/components';
---

<section class="lp-closing" aria-labelledby="lp-closing-title">
	<img class="lp-closing__mark lp-parallax" src="/img/enzml_logo.png" alt="" width="499" height="422" loading="lazy" />
	<div class="lp-closing__copy lp-reveal">
		<h2 id="lp-closing-title">Make your next dataset reusable</h2>
		<p>
			Start with the tools, explore the data model, or help shape the format. EnzymeML is developed in the
			open on GitHub.
		</p>
		<div class="lp-closing__actions">
			<LinkButton href="/usage/" icon="right-arrow">Get started</LinkButton>
			<LinkButton href="https://github.com/EnzymeML" variant="secondary" icon="github" iconPlacement="start">
				GitHub
			</LinkButton>
			<LinkButton href="https://github.com/EnzymeML/enzymeml-specifications/issues" variant="minimal">
				Contribute to the specification
			</LinkButton>
		</div>
	</div>
</section>

<style>
	.lp-closing {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		margin-block: 0 1rem;
		padding: clamp(2.25rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
		border-radius: calc(var(--lp-radius) * 1.5);
		background:
			radial-gradient(60% 90% at 100% 0%, rgb(231 26 75 / 0.45), transparent 70%),
			radial-gradient(50% 80% at 0% 100%, rgb(84 130 147 / 0.5), transparent 70%),
			var(--lp-navy);
		color: #fff;
	}
	.lp-closing__mark {
		position: absolute;
		right: -2rem;
		bottom: -3rem;
		z-index: -1;
		width: clamp(10rem, 28vw, 18rem);
		height: auto;
		opacity: 0.16;
		--lp-shift: -4rem;
	}
	.lp-closing__copy {
		max-width: 38rem;
	}
	h2 {
		margin: 0;
		font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
		line-height: 1.15;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: #fff;
		text-wrap: balance;
	}
	p {
		margin: 1rem 0 0;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: #dfe3ee;
	}
	.lp-closing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 2rem;
	}
	.lp-closing__actions :global(.sl-link-button) {
		margin: 0;
	}
	/* Buttons on the always-navy band: fixed colours in both themes */
	.lp-closing__actions :global(.sl-link-button.primary) {
		background: var(--lp-red);
		border-color: var(--lp-red-text);
		color: #fff;
	}
	.lp-closing__actions :global(.sl-link-button.secondary) {
		border-color: rgb(255 255 255 / 0.7);
		color: #fff;
	}
	.lp-closing__actions :global(.sl-link-button.minimal) {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}
	.lp-closing :global(a:focus-visible) {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
</style>
